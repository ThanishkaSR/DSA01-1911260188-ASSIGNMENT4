# COMPLETE THE CODE

## Complete Code

```cpp
#include <iostream>
#include <string>
using namespace std;

class Person
{
protected:
    string name;
    int age;

public:
    Person(const string& n, int a) : name(n), age(a) {}
};

class Address
{
    string city;
    int pin;

public:
    Address(const string& c, int p) : city(c), pin(p) {}

    string str() const
    {
        return city + "-" + to_string(pin);
    }
};

class Student : public Person
{
    long long regNo;
    Address home;

public:

    Student(const string& n, int a, long long r,
            const string& c, int p)
        : Person(n, a), regNo(r), home(c, p)
    {
    }

    void print() const
    {
        cout << regNo << ' ' << name << " (" << age << ") "
             << home.str() << '\n';
    }
};

int main()
{
    Student s("Kavya", 19, 192311001, "Salem", 636001);

    s.print();

    return 0;
}
```

### Expected Output

```text
192311001 Kavya (19) Salem-636001
```

### Explanation

The constructor initializes:

- Person(n, a) – initializes the base class Person.
- regNo(r) – initializes the registration number.
- home(c, p) – initializes the Address member object.

The initializer list initializes objects directly before the constructor body executes.

